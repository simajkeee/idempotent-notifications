{
    "info": {
        "_postman_id": "1d63369f-8cfc-49c2-9c05-d5389ecbb8be",
        "name": "Notification Service",
        "description": "Requests for testing bulk notification delivery, idempotency, and subscriber notification history.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost/api"
        },
        {
            "key": "subscriber_with_dropped_status_id",
            "value": "3"
        },
        {
            "key": "subscriber_with_delivered_status_id",
            "value": "5"
        },
        {
            "key": "second_subscriber_with_delivered_status_id",
            "value": "6"
        },
        {
            "key": "idempotency_key",
            "value": "postman-bulk-request-1"
        }
    ],
    "item": [
        {
            "name": "Bulk Notifications",
            "item": [
                {
                    "name": "Send Transactional Email Batch",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Batch is accepted', function () {",
                                    "    pm.response.to.have.status(202);",
                                    "});",
                                    "",
                                    "pm.test('Response contains queued batch', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.batch_id).to.be.a('number');",
                                    "    pm.expect(response.notification_count).to.eql(2);",
                                    "    pm.expect(response.status).to.eql('queued');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{idempotency_key}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"channel\": \"email\",\n    \"type\": \"transactional\",\n    \"message\": \"Your order has shipped.\",\n    \"recipient_ids\": [\n        {{subscriber_with_delivered_status_id}},\n        {{second_subscriber_with_delivered_status_id}}\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/notifications/bulk",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "notifications",
                                "bulk"
                            ]
                        },
                        "description": "Happy-path Email batch using seeded subscribers that should reach delivered. Send it again with the same Idempotency-Key to verify the idempotent replay returns 200."
                    }
                },
                {
                    "name": "Reject Conflicting Idempotency Key",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Conflicting payload is rejected', function () {",
                                    "    pm.response.to.have.status(409);",
                                    "    pm.expect(pm.response.json().error).to.eql('idempotency_key_conflict');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{idempotency_key}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"channel\": \"email\",\n    \"type\": \"transactional\",\n    \"message\": \"A different message using the same key.\",\n    \"recipient_ids\": [\n        {{subscriber_with_delivered_status_id}},\n        {{second_subscriber_with_delivered_status_id}}\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/notifications/bulk",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "notifications",
                                "bulk"
                            ]
                        },
                        "description": "Run after Send Transactional Email Batch. It reuses the key with a different payload."
                    }
                },
                {
                    "name": "Send Marketing SMS Batch",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "pm.variables.set('marketing_idempotency_key', `postman-marketing-${Date.now()}`);"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Marketing batch is accepted', function () {",
                                    "    pm.response.to.have.status(202);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Idempotency-Key",
                                "value": "{{marketing_idempotency_key}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"channel\": \"sms\",\n    \"type\": \"marketing\",\n    \"message\": \"This week's offers are available.\",\n    \"recipient_ids\": [\n        {{subscriber_with_dropped_status_id}}\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/notifications/bulk",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "notifications",
                                "bulk"
                            ]
                        },
                        "description": "Failure-path SMS batch using a seeded subscriber that should end in dropped after provider failure."
                    }
                }
            ]
        },
        {
            "name": "Subscriber Notifications",
            "item": [
                {
                    "name": "Get Subscriber Notification History",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('History is returned', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.data).to.be.an('array');",
                                    "    pm.expect(response.meta).to.be.an('object');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/subscribers/{{subscriber_with_dropped_status_id}}/notifications?page=1&per_page=20",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "subscribers",
                                "{{subscriber_with_dropped_status_id}}",
                                "notifications"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "per_page",
                                    "value": "20"
                                }
                            ]
                        }
                    }
                }
            ]
        }
    ]
}
